# Access Token de PRODUÇÃO do Mercado Pago
# Painel do Mercado Pago > Suas integrações > (sua aplicação) > Credenciais de produção
MP_ACCESS_TOKEN=APP_USR-...

# Endereço público do site, sem barra no final (ex.: https://motion-pronto.vercel.app)
SITE_URL=http://localhost:3000

# Segredo longo e aleatório para assinar os links de download (gere com: openssl rand -hex 32)
DOWNLOAD_SECRET=

# Preço em reais (ponto como separador decimal)
KIT_PRICE=19.90
